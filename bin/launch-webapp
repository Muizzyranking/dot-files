#!/usr/bin/env bash
# Description: Launch a URL as a Chrome app window via uwsm-app.
# Usage: launch-webapp <url> [extra-chrome-args...]

source "$HOME/.config/zsh/utils.sh"

BROWSER_CMD="google-chrome-stable"

usage() {
    echo "Usage: $(basename "$0") <url> [extra-chrome-args...]"
}

launch() {
    require_or_exit "$BROWSER_CMD" uwsm-app
    exec uwsm-app -- "$BROWSER_CMD" --app="$1" "${@:2}"
}

main() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -eq 0 ]]; then
        usage
        exit 0
    fi

    launch "$@"
}

main "$@"
