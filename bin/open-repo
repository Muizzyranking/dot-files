#!/usr/bin/env bash
# Description: Opens the current git repository's remote URL in the default browser.
# Usage: open-repo [directory] [-b|--branch]

set -euo pipefail

source "$HOME/.config/zsh/utils.sh"

SHOW_BRANCH=false
TARGET_DIR=""

usage() {
    echo "Usage: $(basename "$0") [directory] [-b|--branch]"
}

get_remote_url() {
    local url
    if ! url=$(git -C "$1" remote get-url origin 2>/dev/null) || [[ -z "$url" ]]; then
        die "No remote 'origin' found."
    fi
    echo "$url"
}

get_current_branch() {
    local branch
    branch=$(git -C "$1" symbolic-ref --short HEAD 2>/dev/null)
    if [[ $? -ne 0 ]]; then
        warn "Could not determine current branch."
        return 1
    fi
    echo "$branch"
}

open_url() {
    local url="$1"
    print_message info "Opening: $url"

    if grep -q Microsoft /proc/version 2>/dev/null || [[ "$(uname -r)" == *"microsoft"* ]]; then
        # WSL
        if command_exists powershell.exe; then
            powershell.exe -Command "Start-Process '$url'"
        elif command_exists wsl-open; then
            wsl-open "$url"
        else
            die "Cannot find way to open URL in WSL."
        fi
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        open "$url"
    elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
        xdg-open "$url"
    else
        die "Unsupported OS."
    fi
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -b | --branch)
            SHOW_BRANCH=true
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        *)
            if [[ -z "$TARGET_DIR" ]]; then
                TARGET_DIR="$1"
            else
                die "Unexpected argument: $1"
            fi
            shift
            ;;
        esac
    done
}

resolve_target() {
    if [[ -z "$TARGET_DIR" ]]; then
        TARGET_DIR="$(pwd)"
    elif [[ "$TARGET_DIR" != /* ]]; then
        # Resolve relative path
        TARGET_DIR="$(pwd)/$TARGET_DIR"
    fi

    if [[ ! -d "$TARGET_DIR" ]]; then
        die "Directory not found: $TARGET_DIR"
    fi

    require_git_repo "$TARGET_DIR"
}

build_url() {
    local remote_url
    remote_url=$(get_remote_url "$TARGET_DIR")

    # Convert SSH to HTTPS
    if [[ $remote_url == git@* ]]; then
        remote_url=$(echo "$remote_url" | sed 's/git@\(.*\):\(.*\)\.git/https:\/\/\1\/\2/')
    fi
    remote_url=${remote_url%.git}

    # Append branch if requested
    if [[ "$SHOW_BRANCH" == true ]]; then
        local branch
        branch=$(get_current_branch "$TARGET_DIR") || true
        if [[ -n "${branch:-}" ]]; then
            if [[ $remote_url == *"github.com"* ]]; then
                remote_url="${remote_url}/tree/${branch}"
            elif [[ $remote_url == *"gitlab.com"* ]]; then
                remote_url="${remote_url}/-/tree/${branch}"
            elif [[ $remote_url == *"bitbucket.org"* ]]; then
                remote_url="${remote_url}/src/${branch}"
            fi
        fi
    fi

    printf '%s' "$remote_url"
}

main() {
    parse_args "$@"
    resolve_target

    local url
    url=$(build_url)
    open_url "$url"
}

main "$@"
