#!/usr/bin/env bash
# Description: Cross-platform clipboard utility. Reads from stdin and copies to system clipboard.
# Usage: echo "text" | clipcopy
#        clipcopy < file.txt

source "$HOME/.config/zsh/utils.sh"

# Log fallback location
LOG_PATH="/tmp/clipcopy_$(date +%s).log"

copy_to_clipboard() {
    if command_exists clip.exe; then
        clip.exe
    elif command_exists wl-copy; then
        wl-copy
    elif command_exists xclip; then
        xclip -in -selection clipboard
    elif command_exists pbcopy; then
        pbcopy
    else
        cat > "$LOG_PATH"
        print_message error "No clipboard utility found. Content saved to $LOG_PATH"
        return 1
    fi
}

usage() {
    echo "Usage: echo 'text' | $(basename "$0")"
    echo "       $(basename "$0") < file.txt"
}

main() {
    # Check if there is input from stdin
    if [ -t 0 ]; then
        usage
        exit 1
    fi

    copy_to_clipboard
}

main "$@"
