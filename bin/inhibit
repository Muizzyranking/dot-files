#!/bin/bash

# Hold a lock to prevent suspend/idle. While ANY lock is held, logind
# refuses to suspend or run idle actions. Locks are named, idempotent,
# and auto-released when a wrapped command exits.
#
# start       holds a lock until `stop <same name>` is called
# stop        releases the lock for <name>
# stop-all    releases every lock
# run         holds a lock until the wrapped command exits (auto-release)
set -euo pipefail

PIDDIR="${TMPDIR:-/tmp}/systemd-inhibit"
mkdir -p "$PIDDIR"

usage() {
    cat <<'EOF'
usage: inhibit <command> [args...]

commands:
  start <name>                  Hold a lock until 'stop <name>' (idempotent).
  stop <name>                   Release the lock for <name> (idempotent).
  stop-all                      Release every lock.
  run [-n NAME] [--] <cmd> ...  Hold a lock for as long as <cmd> runs.
                                Name is derived from <cmd> (sudo, env,
                                command and their flags are skipped).
                                Each run holds its OWN lock, so two windows
                                running the same command are independent and
                                the system stays awake until ALL of them exit.
  -h, --help                    Show this help.

While ANY lock is held, logind refuses to suspend / run idle actions.
EOF
}

die() {
    printf 'error: %s\n' "$1" >&2
    printf 'try: %s --help\n' "$(basename "$0")" >&2
    exit "${2:-1}"
}

pidfile() { printf '%s/%s.pid' "$PIDDIR" "$1"; }

check_name() {
    case "$1" in
    "" | */*) die "invalid name: '$1' (non-empty, no slashes)" ;;
    esac
}

derive_name() {
    local sudo_value_flags=" -u -g -p -C -D -T -U -r -t -R "
    local arg name=""
    while (($#)); do
        arg="$1"
        shift
        case "$arg" in
        sudo | doas | command | builtin | exec)
            continue
            ;;
        env)
            while [[ "${1:-}" == *=* ]]; do shift; done
            continue
            ;;
        -*)
            if [[ "$sudo_value_flags" == *" $arg "* ]] && (($#)); then
                shift
            fi
            continue
            ;;
        *)
            name="${arg##*/}"
            break
            ;;
        esac
    done
    [[ -n "$name" ]] || die "run: could not determine command name"
    printf '%s\n' "$name"
}

cmd_start() {
    local name="$1" f pid
    check_name "$name"
    f="$(pidfile "$name")"
    if [[ -f "$f" ]] && kill -0 "$(cat "$f" 2>/dev/null)" 2>/dev/null; then
        return 0
    fi
    setsid systemd-inhibit \
        --what=sleep:idle \
        --who="${name}" \
        --why="${name}: lock held by inhibit.sh" \
        --mode=block \
        sleep infinity </dev/null &>/dev/null &
    echo $! >"$f"
    disown
}

cmd_stop() {
    local name="$1" f pid
    check_name "$name"
    f="$(pidfile "$name")"
    [[ -f "$f" ]] || return 0
    pid="$(cat "$f" 2>/dev/null || true)"
    [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
    rm -f "$f"
}

cmd_stop_all() {
    local f pid
    shopt -s nullglob
    for f in "$PIDDIR"/*.pid; do
        pid="$(cat "$f" 2>/dev/null || true)"
        [[ -n "$pid" ]] && kill "$pid" 2>/dev/null || true
        rm -f "$f"
    done
}

cmd_run() {
    local name=""
    while (($#)); do
        case "$1" in
        -n | --name)
            [[ $# -ge 2 ]] || die "run: $1 requires a value"
            name="$2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
        esac
    done
    (($#)) || die "run: missing command"
    [[ -z "$name" ]] && name="$(derive_name "$@")"
    check_name "$name"
    exec systemd-inhibit \
        --what=sleep:idle \
        --who="${name}" \
        --why="${name}: running $*" \
        --mode=block \
        -- "$@"
}

main() {
    local action="${1:-}"
    [[ -n "$action" ]] || {
        usage
        exit 2
    }
    shift
    case "$action" in
    start)
        (($#)) || die "start: missing <name>"
        cmd_start "$1"
        ;;
    stop)
        (($#)) || die "stop: missing <name>"
        cmd_stop "$1"
        ;;
    stop-all) cmd_stop_all ;;
    run) cmd_run "$@" ;;
    list) systemd-inhibit --list ;;
    -h | --help | help) usage ;;
    *) die "unknown command: ${action}" 2 ;;
    esac
}
main "$@"
