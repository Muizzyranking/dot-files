#!/usr/bin/env bash
# Description: Toggle a process by exact name (kill if running, start if not).
# Usage: run_cmd <command> [arguments]

source "$HOME/.config/zsh/utils.sh"

usage() {
    echo "Usage: $(basename "$0") <command> [arguments]"
}

toggle_process() {
    local cmd="$1"
    shift

    if ! command_exists "$cmd"; then
        die "Command '$cmd' not found."
    fi

    local pid
    pid=$(pgrep -x "$cmd" || true)

    if [[ -n "$pid" ]]; then
        print_message info "'$cmd' is running (PID: $pid). Closing it..."
        pkill -x "$cmd"
    else
        print_message info "'$cmd' is not running. Starting it..."
        "$cmd" "$@"
    fi
}

main() {
    if [[ $# -eq 0 ]]; then
        usage
        exit 1
    fi

    toggle_process "$@"
}

main "$@"
