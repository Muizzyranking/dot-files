#!/usr/bin/env bash
# Description: Restarts a running process or starts it if not running.
# Usage: restart <process_name> [--detach|-d]
# Example: restart waybar -d
source "$HOME/.config/zsh/utils.sh"

set -euo pipefail

PROCESS_NAME=""
DETACH=false

show_help() {
    echo "Usage: $(basename "$0") <process_name> [--detach|-d]"
    echo
    echo "Options:"
    echo "  --detach, -d   Start the process detached (nohup)"
    echo "  -h, --help     Show this help message"
}

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --detach | -d)
            DETACH=true
            shift
            ;;
        -h | --help)
            show_help
            exit 0
            ;;
        *)
            if [[ -z "$PROCESS_NAME" ]]; then
                PROCESS_NAME="$1"
            else
                die "Multiple process names provided."
            fi
            shift
            ;;
        esac
    done

    if [[ -z "$PROCESS_NAME" ]]; then
        die "Process name is required."
    fi
}

stop_existing() {
    local name="$1"

    if pgrep -x "$name" >/dev/null; then
        print_message info "Killing existing instances..."
        pkill -x "$name"
        sleep 1
        if pgrep -x "$name" >/dev/null; then
            warn "Force killing..."
            pkill -9 -x "$name"
            sleep 1
        fi
    else
        print_message info "Not currently running."
    fi
}

start_process() {
    local name="$1"

    print_message info "Starting $name..."
    if [[ "$DETACH" == true ]]; then
        nohup "$name" >/dev/null 2>&1 &
        disown
        print_message success "Started (detached)."
    else
        "$name" &
        print_message success "Started (background)."
    fi
}

main() {
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    parse_args "$@"
    require_or_exit "$PROCESS_NAME"

    print_message info "Process: $PROCESS_NAME"
    stop_existing "$PROCESS_NAME"
    start_process "$PROCESS_NAME"
}

main "$@"
