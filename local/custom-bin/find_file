#!/usr/bin/env bash
# Description: Fuzzy find files in the current directory with preview and actions.
# Usage: find_file [-h|--help]
# Keybinds:
#   ENTER:  Print path
#   CTRL-O: Open in $EDITOR (defaults to nvim)
#   CTRL-Y: Copy path to clipboard

source "$HOME/.config/zsh/utils.sh"

set -euo pipefail

# Dependencies check
require_or_exit fd fzf

usage() {
    echo "Usage: $(basename "$0")"
    echo
    echo "Fuzzy find files in the current directory with preview and actions."
}

preview_cmd() {
    if command_exists bat; then
        printf '%s' "bat --style=numbers --color=always --line-range :500 {}"
    else
        printf '%s' "cat {}"
    fi
}

pick_file() {
    local preview
    preview=$(preview_cmd)

    local header="FILE FINDER
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ENTER: print path | CTRL-O: open in editor | CTRL-Y: copy path | ESC: exit"

    fd --type f --hidden --exclude .git |
        fzf --tmux 95%,85% \
            --header="$header" --reverse \
            --prompt="Select file > " \
            --preview="$preview" \
            --bind "ctrl-y:execute-silent(echo {} | clipcopy)" \
            --expect=ctrl-o
}

handle_selection() {
    local selection="$1"

    if [[ -z "$selection" ]]; then
        exit 0
    fi

    local key
    local selected_file
    key=$(echo "$selection" | head -1)
    selected_file=$(echo "$selection" | tail -1)

    if [[ -z "$selected_file" ]]; then
        exit 0
    fi

    case "$key" in
    ctrl-o)
        ${EDITOR:-nvim} "$selected_file"
        ;;
    *)
        echo "$selected_file"
        ;;
    esac
}

main() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage
        exit 0
    fi

    local selection
    selection=$(pick_file || true)
    handle_selection "$selection"
}

main "$@"
