[Unit]
Description=Quickshell desktop shell
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/qs
Restart=on-failure
RestartSec=1
Slice=session.slice
# stop a leak from growing without limit
MemoryHigh=400M

[Install]
WantedBy=graphical-session.target
